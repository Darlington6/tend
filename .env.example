# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# From your RevenueCat project (Project Settings > API keys). Use the Test
# Store keys first, swap for real App Store/Play Store keys later.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
